# ========================================================
# Proxmox OS Template Builder Environment Configuration
# ========================================================

# Admin Web Console Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# JWT Secret Key for Session Authentication
JWT_SECRET=puq-pve-builder-super-secret-key-change-me

# Container Port
PORT=8080

# Timezone
TZ=America/Winnipeg

# Storage paths (inside container default to /data)
DATA_DIR=/data
DOWNLOADS_DIR=/data/downloads
CONFIGS_DIR=/data/configs
OUTPUT_DIR=/data/repository

# Libguestfs direct backend (works in Docker without nested KVM)
LIBGUESTFS_BACKEND=direct
